# ---- Core ----
NODE_ENV=development
PORT=5000
# Replace with your MongoDB Atlas string when ready (local default shown).
MONGODB_URI=mongodb://127.0.0.1:27017/avom
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Extra comma-separated origins allowed by CORS (e.g. preview deployments)
EXTRA_ALLOWED_ORIGINS=

# ---- Auth (REQUIRED in production; dev has unsafe fallbacks) ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
STAFF_REFRESH_DAYS=7
STUDENT_REFRESH_DAYS=30
# Production, frontends on different subdomains: COOKIE_SECURE=true, COOKIE_SAMESITE=none (or lax on one parent domain)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---- Cloudinary (mock storage is used automatically while these are blank) ----
CLOUDINARY_CLOUD_NAME=mock-cloud
CLOUDINARY_API_KEY=mock-key
CLOUDINARY_API_SECRET=mock-secret
# auto | cloudinary | mock   (use "mock" to force no real uploads/deletes)
STORAGE_PROVIDER=mock

# ---- Email (Resend). While the key is blank, emails are only logged to the console ----
RESEND_API_KEY=
EMAIL_FROM=AVOM <no-reply@avomglobal.org>
# auto | log | resend
EMAIL_MODE=log
CONTACT_INBOX=info@avomglobal.org

# ---- Paystack (leave blank until payments are switched on) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ---- WhatsApp Business (later) ----
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# ---- Background jobs ----
# Daily expiry/pause sweep. Off in development unless RUN_JOBS=true.
RUN_JOBS=false
JOBS_TIMEZONE=Africa/Lagos
EXPIRY_CRON=0 2 * * *
# Secret for POST /api/v1/internal/run-expiry (header x-cron-secret) when using an external scheduler
CRON_SECRET=

# ---- Proxy ----
# 1 = only Render in front of the API. 2 = Vercel rewrite -> Render (recommended setup, see docs/DEPLOYMENT.md)
TRUST_PROXY_HOPS=2

# ---- First Super Admin ----
# Either run `npm run seed`, or (no shell needed) set SEED_ON_START=true once: the server creates the admin on startup if none exists.
SEED_ON_START=false
# ---- (continued) Used by npm run seed / SEED_ON_START. Change the password immediately after first login ----
SEED_ADMIN_EMAIL=admin@avom.test
SEED_ADMIN_PASSWORD=ChangeMe!12345
SEED_ADMIN_NAME=AVOM Super Admin
